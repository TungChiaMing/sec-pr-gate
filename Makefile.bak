IMAGE ?= sec-pr-gate:latest
TARGET ?= $(CURDIR)/app

.PHONY: build version scan shell clean

build:
	docker build -t $(IMAGE) .

version: build
	docker run --rm $(IMAGE) version

scan: build
	mkdir -p reports
	docker run --rm \
	  -v "$(TARGET):/src:ro" \
	  -v "$(CURDIR)/reports:/out" \
	  -v sec-cache:/cache \
	  $(IMAGE) scan

shell: build
	docker run --rm -it -v "$(TARGET):/src:ro" $(IMAGE) bash

clean:
	rm -rf reports
