# 複製成 .env 後填入
# container 內無法用 `gh auth login` 的瀏覽器流程，一律用 token
# 產生方式：https://github.com/settings/tokens  (classic: repo 範圍即可)
#   或 gh auth token  （在你的 Mac 上，已登入的情況下直接印出現有 token）
GH_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# 要掃的 repo 路徑（給 docker compose 用）
SCAN_TARGET=/Users/ak47885395/code/your-repo

# owner/repo，留空則從 SCAN_TARGET 的 git remote 推斷
GH_REPO=

# 門檻
FAIL_ON_SEMGREP=ERROR
FAIL_ON_TRIVY=HIGH,CRITICAL
